# AI Provider Configuration
# Choose your active provider: "gemini", "openai", "ollama", or "mock"
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# xAI Grok API Key (optional)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest

# Local Ollama Configuration (optional for 100% offline scanning)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Application Settings
MAX_FILE_SIZE_MB=5
ENABLE_AI_REMEDIATION=true
ENABLE_SECRETS_SCAN=true
ENABLE_BANDIT_SCAN=true
ENABLE_SEMGREP_SCAN=true
DATABASE_PATH=database/reviews.db
REPORTS_DIR=reports/
